# Binance API Configuration
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Optional: Testnet configuration
BINANCE_TESTNET=true

# Local data lake paths
# Host path (outside repo recommended)
LAKE_ROOT=/Users/joaquincano/data/binance_lake
# Docker bind mount source path on host
LAKE_ROOT_HOST=/Users/joaquincano/data/binance_lake
# Docker path inside containers
LAKE_ROOT_DOCKER=/data/lake

# Optional macro sources
FRED_API_KEY=your_fred_api_key_here
# CoinGecko Demo API (free): https://www.coingecko.com/en/api/pricing -> Demo API
COINGECKO_API_KEY=your_coingecko_demo_api_key_here
# Glassnode (on-chain): https://studio.glassnode.com/settings/api - requiere plan con API
GLASSNODE_API_KEY=your_glassnode_api_key_here

# Instructions for getting API keys:
# 1. Go to https://binance.com and create an account
# 2. Go to Profile → API Management
# 3. Create a new API key
# 4. Enable these permissions:
#    ✅ Spot & Margin Trading
#    ✅ Futures (for futures trading)
#    ✅ Reading
#    ❌ Withdraw (not recommended for security)
# 5. Copy the API Key and Secret Key here
#
# For testing (RECOMMENDED):
# 1. Go to https://testnet.binance.vision/
# 2. Create a test account
# 3. Generate test API keys
# 4. Set BINANCE_TESTNET=true
# 5. Use test API keys here
